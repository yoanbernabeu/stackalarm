---
import "@fontsource-variable/bricolage-grotesque/opsz.css";
import "@fontsource/ibm-plex-mono/400.css";
import "../styles/global.css";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="noindex" />
    <title>Page not found: stackalarm</title>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main class="not-found wrap">
      <p class="stage" data-stage="alert">404</p>
      <h1>Nothing here</h1>
      <p class="muted">This page does not exist. The watch is still running on the home page.</p>
      <a class="pill" href="/">Back to stackalarm.dev</a>
    </main>
  </body>
</html>
