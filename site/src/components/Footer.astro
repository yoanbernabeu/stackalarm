---
import { repo } from "../lib/repo";

// Every link points to something that exists in the repository or on the site.
const groups = [
  {
    title: "Read",
    links: [
      { href: "/docs/", label: "Docs" },
      { href: "/news/", label: "Security news" },
      { href: "/docs/faq/", label: "Questions" },
      { href: "/llms.txt", label: "llms.txt" },
    ],
  },
  {
    title: "Project",
    links: [
      { href: repo, label: "GitHub" },
      { href: `${repo}/releases`, label: "Releases" },
      { href: `${repo}/issues`, label: "Issues" },
      { href: `${repo}/blob/main/LICENSE`, label: "MIT License" },
    ],
  },
  {
    title: "Take part",
    links: [
      { href: `${repo}/issues/new?template=new-source.yml`, label: "Propose a source" },
      { href: `${repo}/issues/new?template=bug.yml`, label: "Report a bug" },
      { href: `${repo}/blob/main/CONTRIBUTING.md`, label: "Contributing" },
      { href: `${repo}/blob/main/SECURITY.md`, label: "Security" },
    ],
  },
];
---
<footer class="footer">
  <div class="wrap footer-row">
    <p>
      <a class="wordmark small" href="/">/stackalarm</a><br />
      Security news, matched to your stack.<br />
      By <a href="https://yoandev.co">Yoan Bernabeu</a>.
    </p>
    <nav class="footer-groups" aria-label="Project links">
      {groups.map((g) => (
        <div>
          <p class="footer-title">{g.title}</p>
          <ul>
            {g.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </div>
      ))}
    </nav>
  </div>
</footer>
